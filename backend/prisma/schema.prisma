generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
}

model ModelRegistry {
  id            Int      @id @default(autoincrement())
  version       String   @unique
  fileName      String
  fileUrl       String
  sha256        String
  releaseNote   String?
  createdAt     DateTime @default(now())
}
